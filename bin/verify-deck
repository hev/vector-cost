#!/usr/bin/env node
// Check a talk's slide figures against this calculator's model.
//
//   bin/verify-deck                     # the default deck path below
//   bin/verify-deck path/to/slides.md
//
// Both sides are read from source — the model is sliced out of dist/index.html,
// the figures are parsed out of the slides — so a number cannot move on one side
// without failing here. Written after a ladder slide and the calculator spent a
// day disagreeing about whether the retained source text counts.
//
// This lives here rather than beside the deck because the numbers originate
// here: a merged rate correction changes the arithmetic on someone's slide, and
// this is the only thing that notices. It is intentionally NOT in CI — it needs
// a deck checked out, which no CI runner has. Run it after changing a rate.
//
// It is deliberately tolerant of decks it doesn't recognize: a slides.md without
// the expected markup is skipped, not failed.
import { readFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { ROOT } from "./lib.mjs";

const DEFAULT_DECK = join(ROOT, "..", "workshops", "decks", "choosing-a-vector-database", "slides.md");
const slides = process.argv[2] || DEFAULT_DECK;

function die(msg) {
	console.error(`error: ${msg}`);
	process.exit(1);
}
function skip(msg) {
	console.log(`\n  · ${msg}\n`);
	process.exit(0);
}

if (!existsSync(slides)) {
	skip(`no deck at ${slides} — nothing to check (pass a path to slides.md)`);
}
const calc = join(ROOT, "dist", "index.html");
if (!existsSync(calc)) die("dist/index.html does not exist — run bin/build first");

const md = readFileSync(slides, "utf8");
const html = readFileSync(calc, "utf8");

// Lift the model out of the built page rather than reimplementing it — a
// reimplementation would drift from the thing it is supposed to be checking.
const from = html.indexOf("const MONTHS = 36;");
const to = html.indexOf("/* ============================================================\n   FORMATTING");
if (from < 0 || to < 0) die("could not locate the model block in dist/index.html");
const { S, profile, embedCost, schedule, timeline, GB, RATES } = new Function(
	`${html.slice(from, to)}\nreturn {S,profile,embedCost,writeCost,storeCost,schedule,timeline,GB,RATES};`,
)();

let fails = 0;
function near(got, want, tol, label) {
	const ok = Math.abs(got - want) <= tol;
	if (!ok) fails++;
	const g = typeof got === "number" ? +got.toFixed(4) : got;
	console.log(`  ${ok ? "ok  " : "FAIL"}  ${label.padEnd(42)} ${g} vs ${want}`);
}
function reset() {
	Object.assign(S, {
		datasetGB: 1, indexType: "dense", dims: 1536, mvDims: 128, quant: "f32", rescore: false,
		vendor: "turbopuffer", reindexes: 10, embedRate: 0.02,
		chunkKB: 1, hnswM: 16, sparseRatio: 0.3, growth: 0, keepPayload: false,
	});
}
const perGB = (type, dims) => {
	S.indexType = type;
	if (dims) S.dims = dims;
	return profile(GB).bytes / GB;
};

// ---- what the slides claim ------------------------------------------------
// Scope the bar parse to one slide. The deck has a second bar chart further on
// (the quantization slide) whose rows match the same markup, and matching the
// whole file found 8 bars, failed the length check, and skipped the entire run
// silently — which is worse than no checker, because it looks like a pass. The
// ladder is the slide with a `sparse` row; nothing else in the deck has one.
const SLIDES = md.split(/^---$/m);
const ladder = SLIDES.find((s) => /bar-label">sparse/.test(s));
const tiles = SLIDES.find((s) => s.includes("stat-num"));
const embedSlide = SLIDES.find((s) => s.includes("text-embedding-3-small"));
const calcSlide = SLIDES.find((s) => /over three years is \$/.test(s));

const barGB = [...(ladder || "").matchAll(/<span class="bar-val" style="text-align:right">([\d.]+) GB<\/span>/g)].map(
	(m) => parseFloat(m[1]),
);
const widths = [...(ladder || "").matchAll(/bar-fill" style="width:([\d.]+)%/g)].map((m) => parseFloat(m[1]));
const stats = [...(tiles || "").matchAll(/<span class="stat-num">\$([\d.]+)(K?)<\/span>/g)].map(
	(m) => parseFloat(m[1]) * (m[2] === "K" ? 1000 : 1),
);
if (!ladder || !tiles) {
	skip(`${slides} is not the vector-cost deck (no ladder slide / stat tiles) — skipped`);
}
// Past this point the deck IS the vector-cost deck, so a shape that doesn't
// parse is a failure rather than a skip. Skipping here is how the ladder went
// unchecked; a deck that has the slide but not the expected rows is a deck
// someone edited, which is exactly when this needs to speak up.
if (barGB.length !== 4 || widths.length !== 4 || stats.length !== 3) {
	die(
		`recognized the deck but not its shape — ladder has ${barGB.length} bars and ${widths.length} fills ` +
			`(expected 4 and 4), stat tiles ${stats.length} (expected 3). Update this parser or the slide.`,
	);
}

// The priced corpus is read off the slide rather than hardcoded here, so
// re-anchoring the deck to a different size is a slides-only edit. Every dollar
// figure below scales from this one number.
const sizeM = tiles.match(/^##\s+([\d,.]+)\s*(GB|TB)\s+of documents/m);
if (!sizeM) {
	die('could not read the priced corpus size — the stat-tile slide needs a heading like "## 100 GB of documents."');
}
const corpusGB = parseFloat(sizeM[1].replace(/,/g, "")) * (sizeM[2] === "TB" ? 1000 : 1);
const corpusLabel = `${sizeM[1]} ${sizeM[2]}`;
const dollars = (s) => parseFloat(s.replace(/,/g, ""));
// Dollar figures are rounded for the slide, so they need a relative tolerance —
// an absolute one sized for a terabyte silently stops testing anything at 100 GB.
const round = (want) => Math.max(1, Math.abs(want) * 0.01);

console.log(`\n${slides.replace(`${join(ROOT, "..")}/`, "")} — slides vs dist/index.html\n`);

console.log("ladder · per 1 GB of source, index structures only");
reset();
near(perGB("sparse"), barGB[0], 0.05, "sparse");
near(perGB("dense", 1536), barGB[1], 0.05, "dense 1536-d");
near(perGB("dense", 3072), barGB[2], 0.05, "dense 3072-d");
near(perGB("multi"), barGB[3], 0.05, "multi-vector");
barGB.forEach((gb, i) => near(widths[i], (gb / barGB[3]) * 100, 0.05, `bar ${i + 1} width is linear`));

console.log("\nthe retained source is the same 1x on every row");
reset();
S.keepPayload = true;
near(perGB("sparse"), barGB[0] + 1, 0.05, "sparse all-in");
near(perGB("dense", 1536), barGB[1] + 1, 0.05, "dense all-in");
near(perGB("multi"), barGB[3] + 1, 0.05, "multi-vector all-in");

// The deck quotes a cross-vendor average and each vendor's rate as prose. Those
// are hand-copied, which means a rate correction merged here would otherwise
// leave the slide quietly wrong — the single most likely way this repo breaks
// something outside it.
//
// One sentence on the ladder-with-prices slide is the authority, and it is
// parsed as a whole rather than by hunting each vendor name through 800 lines:
//   "average vendor storage cost of $0.25/GB-month — Pinecone $0.33, ... "
console.log("\nthe rate cards behind the deck's average");
const avg = md.match(
	/average vendor storage cost of <strong>\$([\d.]+)\/GB-month<\/strong>\s*—\s*([^.]*(?:\.\d+[^.]*)*)\./,
);
if (!avg) die("could not find the sentence stating the deck's average vendor storage cost");
const quotedAvg = parseFloat(avg[1]);

// Look each card's own name up in the sentence rather than tokenizing the
// sentence and hoping the tokens come back as vendor names. A name is whatever
// rates/<id>.json says it is, and "S3 Vectors" is two words — a generic
// "\w+ $\d" scan captures "Vectors", which matches no card and can never be
// satisfied by any wording of the slide.
const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const rateOf = (name) => {
	const m = avg[2].match(new RegExp(`${escapeRe(name)}\\s+\\$(\\d+(?:\\.\\d+)?)`, "i"));
	return m ? parseFloat(m[1]) : undefined;
};

// Count the prices the sentence states, not the names matched, so a vendor on
// the slide that has no rate card here still trips the count.
const stated = [...avg[2].matchAll(/\$\d+(?:\.\d+)?/g)].length;
near(stated, RATES.length, 0, `the slide names ${stated} vendors, the calculator ships ${RATES.length}`);
for (const card of RATES) {
	const got = rateOf(card.name);
	if (got === undefined) {
		fails++;
		console.log(`  FAIL  ${`slide names a rate for ${card.name}`.padEnd(42)} absent from that sentence`);
		continue;
	}
	near(got, card.storage.perUnitMonth, 0.001, `${card.name} quoted at its rate-card rate`);
}
// The slide rounds the mean to the cent it then does arithmetic with, so check
// the rounding — not equality. If a rate moves enough to change that cent, this
// fails and the slide has to be rewritten, which is the point.
const mean = RATES.reduce((a, c) => a + c.storage.perUnitMonth, 0) / RATES.length;
near(Math.round(mean * 100) / 100, quotedAvg, 0.0001, `mean of the cards (${mean.toFixed(4)}) rounds to the quoted average`);

// Everything below prices at the figure actually printed on the slide, so the
// stat tiles are checked on the deck's own basis rather than the unrounded mean.
console.log(`\nstorage bill · ${corpusLabel} at the $${quotedAvg.toFixed(2)}/GB-month deck average`);
reset();
const yr = (type, dims) => perGB(type, dims) * corpusGB * quotedAvg * 12;
near(yr("sparse"), stats[0], round(stats[0]), "sparse $/year");
near(yr("dense", 1536), stats[1], round(stats[1]), "dense $/year");
near(yr("multi"), stats[2], round(stats[2]), "multi-vector $/year");
const sparseGB = perGB("sparse");
const denseGB = perGB("dense", 1536);
const mvGB = perGB("multi");
near(mvGB / sparseGB, +md.match(/annual bill <strong>(\d+)×<\/strong>/)[1], 1, "end-to-end spread");
near(mvGB / denseGB, +md.match(/(\d+)× on the dense → multi-vector step/)[1], 0.5, "dense → multi-vector step");

// Read the table rather than assert frozen constants: the slide states a corpus
// size, a pass count and two dollar figures per row, and all four are checkable.
// Hardcoding them here meant a resized deck needed this file edited in lockstep.
console.log("\nembedding · OpenAI published per-million rates");
if (!embedSlide) die("could not find the embedding-cost slide (no text-embedding-3-small)");
const embedRows = [
	...embedSlide.matchAll(/^\|\s*([\d.,]+)\s*(GB|TB)([^|]*)\|\s*\*{0,2}\$([\d,]+)\*{0,2}\s*\|\s*\*{0,2}\$([\d,]+)\*{0,2}\s*\|/gm),
];
if (!embedRows.length) die("recognized the embedding slide but not its table rows — update this parser or the slide");
for (const [, num, unit, rest, small, large] of embedRows) {
	const gb = parseFloat(num.replace(/,/g, "")) * (unit === "TB" ? 1000 : 1);
	const passes = +(rest.match(/×\s*(\d+)/)?.[1] ?? 1);
	const label = `${num} ${unit}${passes > 1 ? ` × ${passes}` : ""}`;
	for (const [model, rate, want] of [
		["3-small", 0.02, dollars(small)],
		["3-large", 0.13, dollars(large)],
	]) {
		reset();
		S.embedRate = rate;
		near(embedCost(gb * GB) * passes, want, round(want), `${label} on ${model}`);
	}
}
reset();
S.embedRate = 0.02;
S.indexType = "sparse";
near(embedCost(corpusGB * GB), 0, 0, "sparse costs nothing to embed");

console.log("\nquantization · the ColPali page");
near((1030 * 128 * 4) / 1000, +md.match(/ColPali, 1030 × 128-d f32 = \*\*(\d+) KB\*\*/)[1], 0.5, "1030 × 128-d f32 KB");
near((1030 * 128 * 4) / (1030 * 128 * 0.125), 32, 0.01, "binary is a 32× cut");
reset();
S.quant = "binary";
S.rescore = true;
const both = perGB("multi");
reset();
near(both > perGB("multi"), true, 0, "binary + rescore exceeds plain f32");

console.log("\ntimeline · 10 re-indexes over 36 months");
reset();
const sched = [...schedule()].sort((a, b) => a - b);
near(sched.length, 10, 0, `evenly spread: ${sched.join(", ")}`);

reset();
S.datasetGB = corpusGB;
const idx = profile(corpusGB * GB);
const last = timeline().at(-1);
const tp = RATES.find((c) => c.id === "turbopuffer");
const tpWrite = tp?.write.paths[0].perUnit ?? 2.0;
near(last.cWrite, (idx.bytes / GB) * tpWrite * 11, 5, `writes = 11 × index GB × $${tpWrite.toFixed(2)}`);
near(last.cEmbed, embedCost(corpusGB * GB) * 11, 5, "embedding = 11 × one pass");

// The calculator slide states this run twice — rounded in the body, exact in the
// notes — and until now neither was checked, which is the figure most likely to
// be left behind by a resize because it also lives in a screenshot.
console.log("\nthe calculator slide's own headline");
if (!calcSlide) die("could not find the calculator slide (no 36-month total in its notes)");
const exact = calcSlide.match(/over three years is \$([\d,]+)/);
if (!exact) die("the calculator slide's notes no longer state the 36-month total");
near(last.cum, dollars(exact[1]), round(dollars(exact[1])), "36-month total, exact (notes)");

const headline = calcSlide.match(/\*\*([\d,.]+)\s*(GB|TB)\s*→\s*\$([\d.]+)(K|M)?\s+over 36 months/);
if (!headline) die("the calculator slide no longer states a `size → $total over 36 months` headline");
const headGB = parseFloat(headline[1].replace(/,/g, "")) * (headline[2] === "TB" ? 1000 : 1);
near(headGB, corpusGB, 0, "headline corpus matches the priced corpus");
const mult = { K: 1e3, M: 1e6 }[headline[4]] ?? 1;
near(last.cum, parseFloat(headline[3]) * mult, round(parseFloat(headline[3]) * mult), "36-month total, rounded (body)");

const disk = calcSlide.match(/becomes ([\d.]+) (GB|TB) on disk — ([\d.]+)×/);
if (disk) {
	const diskGB = parseFloat(disk[1]) * (disk[2] === "TB" ? 1000 : 1);
	near(idx.bytes / GB, diskGB, round(diskGB), "indexed size stated in the notes");
	near(idx.bytes / (corpusGB * GB), parseFloat(disk[3]), 0.01, "write amplification stated in the notes");
}

console.log(
	`\n  ${corpusLabel} dense 1536 on turbopuffer: ${(idx.bytes / GB).toFixed(0)} GB indexed ` +
		`(${(idx.bytes / (corpusGB * GB)).toFixed(2)}×), $${Math.round(last.cum).toLocaleString()} over 36 months`,
);

console.log(fails ? `\n${fails} check(s) FAILED — slides and calculator disagree\n` : "\nall checks pass\n");
process.exit(fails ? 1 : 0);
